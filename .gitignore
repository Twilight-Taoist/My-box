# 操作系统生成的文件
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# 日志与临时文件
*.log
*.tmp
*.temp
*.bak

# Node.js
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# 编译 / 构建产物
build/
dist/
out/
*.exe

# ---- .NET / C#（2026-10-07 新增，C# 阶段开始）----
# VS 生成的中间目录：里面有上千个文件，绝不能进仓库
bin/
obj/
# VS 用户级配置与解决方案缓存
*.user
*.suo
*.userosscache
*.sln.docstates
# NuGet 还原产物（本项目不提交包缓存）
packages/
*.nupkg
# VS 的 .vs 隐藏目录（上面已有，这里再列一次防漏写路径）
**/.vs/
